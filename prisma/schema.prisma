generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String   @id @default(uuid()) @db.Char(36)
  name              String   @db.VarChar(255)
  taxId             String?  @db.VarChar(50)
  contactEmail      String   @db.VarChar(255)
  contactPhone      String?  @db.VarChar(50)
  lineOaChannelId   String?  @db.VarChar(255)
  lineOaChannelSecret String? @db.VarChar(255)
  lineOaAccessToken String?  @db.Text
  lineOaUserId      String?  @db.VarChar(255)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  companyUsers      CompanyUser[]
  employees         Employee[]
  faqs              Faq[]
  conversations     Conversation[]
  broadcasts        Broadcast[]
  auditLogs         AuditLog[]

  @@index([isActive])
  @@map("companies")
}

model SystemAdmin {
  id            String   @id @default(uuid()) @db.Char(36)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  fullName      String   @db.VarChar(255)
  role          String   @default("super_admin") @db.VarChar(50)
  createdAt     DateTime @default(now())

  @@index([email])
  @@map("system_admins")
}

model CompanyUser {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  email         String   @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  fullName      String   @db.VarChar(255)
  role          String   @default("company_admin") @db.VarChar(50)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs     AuditLog[]

  @@index([companyId])
  @@index([email])
  @@map("company_users")
}

model Employee {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  employeeId    String   @db.VarChar(100)
  firstName     String   @db.VarChar(100)
  lastName      String   @db.VarChar(100)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  lineUserId    String?  @db.VarChar(255)
  department    String?  @db.VarChar(100)
  position      String?  @db.VarChar(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([companyId])
  @@index([employeeId])
  @@index([lineUserId])
  @@map("employees")
}

model Faq {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  question    String   @db.Text
  answer      String   @db.Text
  category    String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
  @@map("faqs")
}

model Conversation {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @db.Char(36)
  lineUserId  String   @db.VarChar(255)
  employeeId  String?  @db.Char(36)
  status      String   @default("active") @db.VarChar(50)
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([companyId])
  @@index([lineUserId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id          String   @id @default(uuid()) @db.Char(36)
  conversationId String @db.Char(36)
  direction   String   @db.VarChar(20) // inbound | outbound
  messageType String   @default("text") @db.VarChar(50)
  content     String   @db.Text
  aiHandled   Boolean  @default(false)
  createdAt   DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([direction])
  @@map("messages")
}

model Broadcast {
  id            String   @id @default(uuid()) @db.Char(36)
  companyId     String   @db.Char(36)
  title         String   @db.VarChar(255)
  message       String   @db.Text
  targetAudience String  @default("all") @db.VarChar(50)
  sentAt        DateTime?
  status        String   @default("pending") @db.VarChar(50)

  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("broadcasts")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Char(36)
  key         String   @unique @db.VarChar(255)
  value       String   @db.Text
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("system_settings")
}

model SchemaMigration {
  id        String   @id @default(uuid()) @db.Char(36)
  version   String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  executedAt DateTime @default(now())

  @@index([version])
  @@map("schema_migrations")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String?  @db.Char(36)
  userId      String?  @db.Char(36)
  userType    String   @db.VarChar(50) // system_admin | company_admin | company_staff
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.Char(36)
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  createdAt   DateTime @default(now())

  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([createdAt])
  @@map("audit_logs")
}
