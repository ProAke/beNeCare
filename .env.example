# beNeCare Environment Variables
# คัดลอกเป็น .env แล้วกรอกค่าจริงก่อนรันระบบบน bebecare.uarea.in

# ============================================================================
# โดเมนเว็บไซต์ (ตั้งเป็น bebecare.uarea.in)
# ============================================================================
NEXTAUTH_URL="https://bebecare.uarea.in"
APP_URL="https://bebecare.uarea.in"

# ============================================================================
# ฐานข้อมูล MariaDB
# ============================================================================
# ถ้าฐานข้อมูลอยู่เครื่องเดียวกับเว็บเซิร์ฟเวอร์ ใช้ host เป็น localhost
# ถ้าฐานข้อมูลอยู่คนละเซิร์ฟเวอร์ ใช้ host เป็น IP หรือ domain ของ database server
DATABASE_URL="mysql://root:รหัสผ่าน_db_ของคุณ@localhost:3306/benecare"

# ============================================================================
# รหัสลับสำหรับ NextAuth / Session (เปลี่ยนเป็นค่าสุ่มจริงก่อนใช้งานจริง)
# ============================================================================
NEXTAUTH_SECRET="เปลี่ยนเป็นสร็อตสุ่มยาวๆ เช่น openssl rand -base64 32"

# ============================================================================
# LINE Official Account (LINE Developers Console)
# ============================================================================
LINE_CHANNEL_ID="ลำดับช่องทาง LINE ของคุณ"
LINE_CHANNEL_SECRET="รหัสลับช่องทาง LINE ของคุณ"
LINE_CHANNEL_ACCESS_TOKEN="โทเค็นเข้าถึงช่องทาง LINE ของคุณ"

# ============================================================================
# AI (OpenAI / Azure OpenAI) — สำหรับตอบคำถามอัตโนมัติ
# ============================================================================
OPENAI_API_KEY="คีย์ API ของคุณ"
OPENAI_MODEL="gpt-4o-mini"

# ============================================================================
# เวอร์ชันระบบ
# ============================================================================
APP_NAME="beNeCare"
APP_VERSION="1.0.0"

# รหัส PIN สำหรับเข้าถึงหน้าติดตั้ง / จัดการระบบ (เปลี่ยนเป็นรหัสของคุณก่อนใช้งานจริง)
INSTALL_PIN="524452"

# เวอร์ชันล่าสุดสำหรับตรวจสอบอัปเดต (ตั้งค่าเมื่อมีเวอร์ชันใหม่ออก)
NEXT_PUBLIC_LATEST_VERSION="1.1.0"
