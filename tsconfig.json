{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": [
      "@types/node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "composables/**/*.ts",
    "components/**/*.vue",
    "pages/**/*.vue",
    "app.vue",
    "nuxt.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".output",
    "dist"
  ]
}
