# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# nuxt
/.output
/dist
/.nuxt

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (don't commit real .env)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# install config (created by installer at runtime)
/data/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow example env file
!.env.example
